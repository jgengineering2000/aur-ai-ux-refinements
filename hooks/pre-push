#!/usr/bin/env bash
# pre-push hook: two refusals at the boundary where content leaves.
#
#   1. WHITELIST — refuses pushes from any repository not listed in
#      ~/.claude/git-public-projects.txt. Failure mode is deny: an unreadable
#      whitelist or an unresolvable toplevel refuses the push.
#
#   2. CONTENT — scans everything the push would INTRODUCE for PII,
#      personal-tree paths and cross-project leakage. This is the stage that
#      matters, because `git commit --no-verify` skips the commit-time scan
#      and nothing else stands between that and publication. Up to this point
#      a leak is local and `filter-repo` is cheap; past it, it is not.
#
# Pushes to local paths, file:// or the designated 'router' remote are always
# allowed: they reach a mounted filesystem, not the public internet, and that
# push is the sanctioned backup for exactly the repos this hook protects.

set -uo pipefail

dest_remote="${1:-}"
dest_url="${2:-}"

if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    echo "[pre-push] FATAL: cannot resolve git toplevel. Refusing push." >&2
    exit 1
fi

is_local=0
if [[ "$dest_remote" == "router" || "$dest_url" == /* || "$dest_url" == file://* ]]; then
    is_local=1
fi

# ── 1 · whitelist ───────────────────────────────────────────────────────────
if [[ $is_local -eq 0 ]]; then
    WHITELIST="${HOME}/.claude/git-public-projects.txt"

    if [[ ! -r "$WHITELIST" ]]; then
        echo "[pre-push] FATAL: whitelist $WHITELIST is unreadable. Refusing push." >&2
        exit 1
    fi

    allowed=0
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$repo_root" == "$line" || "$repo_root" == "$line"/* ]]; then
            allowed=1
            break
        fi
    done < "$WHITELIST"

    if [[ $allowed -eq 0 ]]; then
        cat >&2 <<EOF
[pre-push] BLOCKED.

This repository ($repo_root) is not on the public-projects whitelist
($WHITELIST). It is treated as patent-IP-protected by default.

If this project's IP status has changed and it is cleared for public
disclosure, add its absolute path to the whitelist and try again.

To bypass this hook is to disclose. Do not use --no-verify without
acknowledging that you are releasing this project's contents publicly.
EOF
        exit 1
    fi
fi

# ── 2 · content ─────────────────────────────────────────────────────────────
# Only for pushes that actually publish. A router backup carries the same
# bytes to a private drive; scanning it would block the backup over content
# that is already committed and already local.
[[ $is_local -eq 1 ]] && exit 0

GUARD=""
for c in "$HOME/.local/aur/commit-guard.py" \
         "$HOME/develop/aur/tools/commit-guard.py"; do
    [ -r "$c" ] && { GUARD="$c"; break; }
done
if [[ -z "$GUARD" ]]; then
    echo "[pre-push] WARNING: commit-guard.py not found — pushed content was" \
         "NOT scanned. This is a publishing push." >&2
    exit 0
fi

# git feeds one line per ref on stdin: <local-ref> <local-oid> <remote-ref> <remote-oid>
ZERO=0000000000000000000000000000000000000000
rc_total=0
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" == "$ZERO" ]] && continue          # deletion: nothing added
    if [[ "$remote_oid" == "$ZERO" ]]; then
        # New branch on the remote. Scan what it adds beyond every ref the
        # remote already has, so an entire history is not re-reported.
        range="$local_oid --not --remotes=${dest_remote:-origin}"
    else
        range="${remote_oid}..${local_oid}"
    fi
    python3 "$GUARD" "$repo_root" --range "$range" || rc_total=1
done

if [[ $rc_total -ne 0 ]]; then
    echo "[pre-push] CONTENT FOUND IN PUSHED RANGE — push blocked." >&2
    echo "  This is the last cheap moment: the content is still local, so a" >&2
    echo "  history rewrite costs nothing. After publication it costs a lot." >&2
    exit 1
fi
exit 0
