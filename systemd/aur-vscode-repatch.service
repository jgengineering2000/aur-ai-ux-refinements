#
# Root oneshot behind aur-vscode-repatch.path. Runs ONLY root-owned copies
# under /usr/local/lib/aur/ — automating elevation over the user-writable
# checkout would hand root to anything that can edit those files; the
# root-owned copy is what makes unattended repair safe to grant.
#
# __HOME__ is substituted with the installing user's home by
# install-root-repatch.py.

[Unit]
Description=Re-apply the AUR A4 spellcheck patch after a VS Code update
# THE OPT-OUT: a user-owned flag file, checked before anything runs. The
# repair dialog's "Disable auto-repair" button creates it; deleting it
# re-enables. A user-owned flag can only suppress the repair, never grant
# anything, which is why root may trust it.
ConditionPathExists=!__HOME__/.config/aur/vscode-repatch.optout
# An update can rewrite the file several times in a burst; never let the
# rate limiter wedge the unit (the aur-reapply 2.1.216->218 lesson).
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Let the package manager finish writing before patching the final file.
ExecStartPre=/usr/bin/sleep 8
ExecStart=/usr/local/lib/aur/repatch-and-report.sh

[Install]
# Boot-time backstop: an update applied while the watcher was not running
# (offline upgrade, first boot after install) is repaired at the next boot.
# Idempotent — an already-patched file reports "already" and no event fires.
WantedBy=multi-user.target
